text = input("Enter the message: ")
for k in range(1, 26):
    encrypted = ""
    for ch in text:
        if ch.isupper():
            encrypted += chr((ord(ch) - ord('A') + k) % 26 + ord('A'))
        elif ch.islower():
            encrypted += chr((ord(ch) - ord('a') + k) % 26 + ord('a'))
        else:
            encrypted += ch
    print("Shift", k, ":", encrypted)
