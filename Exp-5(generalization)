text = input("Enter plaintext: ").upper()
a = int(input("Enter a: "))
b = int(input("Enter b: "))

if a % 2 == 0 or a % 13 == 0:
    print("Invalid value of a")
else:
    encrypted = ""

    for ch in text:
        if ch.isalpha():
            p = ord(ch) - ord('A')
            c = (a * p + b) % 26
            encrypted += chr(c + ord('A'))
        else:
            encrypted += ch

    print("Encrypted text:", encrypted)
