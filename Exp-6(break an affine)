cipher = input("Enter ciphertext: ").upper()

# Assume B -> E and U -> T
c1 = ord('B') - ord('A')
c2 = ord('U') - ord('A')
p1 = ord('E') - ord('A')
p2 = ord('T') - ord('A')

for a in range(1, 26):
    if a % 2 != 0 and a % 13 != 0:
        for b in range(26):
            if (a * p1 + b) % 26 == c1 and (a * p2 + b) % 26 == c2:
                decrypted = ""
                inv = next(x for x in range(26)
                           if (a * x) % 26 == 1)

                for ch in cipher:
                    if ch.isalpha():
                        c = ord(ch) - ord('A')
                        p = (inv * (c - b)) % 26
                        decrypted += chr(p + ord('A'))
                    else:
                        decrypted += ch

                print("a =", a, "b =", b)
                print("Decrypted text:", decrypted)
